# Password for the web UI (at least 12 characters).
LOGSERVER_PASSWORD=

# Must match INGEST_TOKEN in app/diagnostics.py. It ships in the public image,
# so it only keeps casual bots out; it does not protect anything.
LOGSERVER_TOKEN=fa42f4bd6461404edec6da425a4ba1ab38b64535577ee8f7710b9df977867238

# Optional
LOGSERVER_RETENTION_DAYS=90
# Set to false only to try the UI over plain http on localhost.
LOGSERVER_COOKIE_SECURE=true

# Address the port is published on. The default is localhost only.
# LOGSERVER_BIND=127.0.0.1

# Timezone for times shown in the UI.
TZ=Europe/Brussels

# Cloudflare Tunnel token for the public route.
TUNNEL_TOKEN=
